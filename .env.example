# Alpaca paper API keys. Keep real values only in local .env or GitHub Secrets.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true

# Trading universe
ALPACA_SYMBOLS=AAPL
SONTRADE_BENCHMARK=SPY

# Data: use yfinance for keyless backtest, alpaca for Alpaca market data
SONTRADE_DATA_PROVIDER=yfinance
ALPACA_DATA_FEED=iex
ALPACA_TIMEFRAME=1Day
SONTRADE_LOOKBACK_DAYS=2500

# Strategy settings
SONTRADE_TRADE_DIRECTION=both
SONTRADE_HORIZON_BARS=8
SONTRADE_LABEL_THRESHOLD=0.003
SONTRADE_LONG_THRESHOLD=0.20
SONTRADE_SHORT_THRESHOLD=0.48
SONTRADE_MIN_EDGE_GAP=0.03
SONTRADE_STOP_ATR_MULT=3.2
SONTRADE_TP_R=0.6
SONTRADE_MIN_STOP_PCT=0.002
SONTRADE_MAX_STOP_PCT=0.066

# Realistic backtest execution-cost model
SONTRADE_COMMISSION_BPS_PER_SIDE=0.0
SONTRADE_SPREAD_BPS_ROUND_TRIP=2.0
SONTRADE_SLIPPAGE_BPS_PER_SIDE=1.0
SONTRADE_SHORT_BORROW_APR=0.03
SONTRADE_FILL_PROBABILITY=0.98
SONTRADE_MAX_ATR_PCT_FOR_FILL=0.12
SONTRADE_MIN_DOLLAR_VOLUME=1000000
SONTRADE_BARS_PER_YEAR=252
SONTRADE_RANDOM_SEED=42

# Risk controls
SONTRADE_RISK_PER_TRADE=0.005
SONTRADE_MAX_NOTIONAL=6000
SONTRADE_MAX_POSITIONS=4
SONTRADE_MIN_ORDER_DOLLARS=50
SONTRADE_LOOP_SECONDS=900
